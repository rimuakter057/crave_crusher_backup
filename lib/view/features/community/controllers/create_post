import 'package:crave_crusher/helper/shared_prefe/shared_prefe.dart';
import 'package:crave_crusher/service/api_client.dart';
import 'package:crave_crusher/service/api_url.dart';
import 'package:get/get.dart';
import 'package:image_picker/image_picker.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'dart:io';

import '../../../../utils/app_const/app_const.dart' show AppConstants;

class AddPostController extends GetxController {
  //============================= Rx Variables ===========================
  var postText = ''.obs;
  var imagePath = ''.obs;
  var isLoading = false.obs;

  RxString userID = ''.obs;

  @override
  void onInit() {
    loadUserId();
    super.onInit();
  }

  //============================= User ID Load ===========================
  loadUserId() async {
    SharedPreferences sharedPreferences = await SharedPreferences.getInstance();
    userID.value = sharedPreferences.getString(AppConstants.userId) ?? '';
    print("Loaded User ID: ${userID.value}");
  }

  //============================= Image Picker ===========================
  Future<void> pickImage({bool fromCamera = true}) async {
    final ImagePicker _imagePicker = ImagePicker();
    final image = await _imagePicker.pickImage(
      source: fromCamera ? ImageSource.camera : ImageSource.gallery,
    );

    if (image != null) {
      imagePath.value = image.path;
    }
  }

  void removeImage() {
    imagePath.value = '';
  }

  //============================= Validation ============================
  bool validatePost() {
    if (postText.value.trim().isEmpty) {
      Get.snackbar("Error", "post content can not empty");
      return false;
    }

    if (userID.value.isEmpty) {
      Get.snackbar("Error", "please login again");
      return false;
    }

    return true;
  }

  //============================= Create Post ============================
  Future<void> createPost() async {
    if (!validatePost()) return;

    isLoading.value = true;

    try {
      Map<String, String> body = {
        'content': postText.value.trim(),
        'authorId': userID.value,  // ======= FIXED HERE =======
      };

      List<MultipartBody>? multipartFiles;
      if (imagePath.value.isNotEmpty) {
        multipartFiles = [
          MultipartBody('post_images', File(imagePath.value))
        ];
      }

      final response = await ApiClient.postMultipartData(
        ApiUrl.createPost,
        body,
        multipartBody: multipartFiles,
      );

      if (response.statusCode == 200) {
        Get.snackbar("Success", "Create Post Success");
        postText.value = '';
        imagePath.value = '';
      } else {
        Get.snackbar("Error", response.body['message'] ?? "Something Went Wrong");
      }
    } catch (e) {
      Get.snackbar("Error", e.toString());
    } finally {
      isLoading.value = false;
    }
  }
}
