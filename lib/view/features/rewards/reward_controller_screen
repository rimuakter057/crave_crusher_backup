import 'package:crave_crusher/utils/app_colors/app_colors.dart';
import 'package:crave_crusher/utils/app_icons/app_icons.dart';
import 'package:crave_crusher/view/components/custom_container/custom_container.dart';
import 'package:crave_crusher/view/components/custom_image/custom_image.dart';
import 'package:crave_crusher/view/components/custom_leadin_title_appbar.dart';
import 'package:crave_crusher/view/components/custom_nav_bar/navbar.dart';
import 'package:crave_crusher/view/components/custom_text/custom_text.dart';
import 'package:crave_crusher/view/features/rewards/widgets/custom_circular_indicator.dart';
import 'package:flutter/material.dart';
import 'package:flutter_screenutil/flutter_screenutil.dart';
import 'package:gap/gap.dart';
import 'controller/reward_controller.dart';
import 'data/battle_category_item_list.dart';
import 'data/battle_item_details_list.dart';
import 'package:get/get.dart';


class RewardsScreen extends StatelessWidget {
  RewardsScreen({super.key});

  // Get the controller instance from DI
  final RewardsController controller = Get.find<RewardsController>();

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      bottomNavigationBar: NavBar(currentIndex: 3),
      appBar: CustomLeadingTitleAppbar(title: "Reward"),
      body: SingleChildScrollView(
        child: Padding(
          padding: EdgeInsets.symmetric(horizontal: 16.w),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              /// Show dynamic progress
              Center(
                child: Obx(() => CustomCircularIndicator(
                  percentText: '${(controller.progress.value * 100).toInt()}%',
                  percent: controller.progress.value,
                )),
              ),

              _buildGainedBadgeText(title: "Ongoing Progress "),

              /// Conditional section based on progress
              Obx(() {
                if (controller.progress.value >= 0.7) {
                  // Show upper horizontal list
                  return Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      _buildGainedBadgeText(title: "Gained Badges"),
                      SizedBox(
                        height: 82.h,
                        child: ListView.separated(
                          scrollDirection: Axis.horizontal,
                          itemCount: battleCategoryItems.length,
                          separatorBuilder: (_, __) => SizedBox(width: 12.w),
                          itemBuilder: (context, index) {
                            final item = battleCategoryItems[index];
                            return CustomContainer(
                              width: 104.w,
                              height: 82.h,
                              backgroundColor: item.backgroundColor,
                              borderColor: item.borderColor,
                              child: Column(
                                mainAxisAlignment: MainAxisAlignment.center,
                                children: [
                                  CustomImage(
                                    imageSrc: item.icon,
                                    height: 32.h,
                                    width: 32.w,
                                  ),
                                  Gap(4.h),
                                  CustomText(text: item.title, fontSize: 10),
                                ],
                              ),
                            );
                          },
                        ),
                      ),
                    ],
                  );
                } else {
                  // Show lower vertical list
                  return Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      _buildGainedBadgeText(title: "Gained Badges"),
                      ListView.separated(
                        shrinkWrap: true,
                        physics: NeverScrollableScrollPhysics(),
                        itemCount: battleDetailItems.length,
                        separatorBuilder: (_, __) => SizedBox(height: 8.h),
                        itemBuilder: (context, index) {
                          final itemDetails = battleDetailItems[index];
                          return CustomContainer(
                            borderColor: AppColors.subPrimary,
                            width: double.infinity,
                            padding: 12,
                            child: Row(
                              mainAxisAlignment: MainAxisAlignment.spaceBetween,
                              children: [
                                Expanded(
                                  child: Row(
                                    children: [
                                      Container(
                                        height: 30.h,
                                        width: 30.w,
                                        alignment: Alignment.center,
                                        decoration: BoxDecoration(
                                          color: itemDetails.backgroundColor,
                                          border: Border.all(
                                            color: itemDetails.borderColor,
                                          ),
                                          borderRadius: BorderRadius.circular(3),
                                        ),
                                        child: CustomImage(
                                          imageSrc: itemDetails.icon,
                                          height: 22.h,
                                          width: 22.w,
                                        ),
                                      ),
                                      Gap(12.w),
                                      CustomText(
                                        text: itemDetails.title,
                                        fontSize: 14,
                                        fontWeight: FontWeight.w500,
                                      ),
                                    ],
                                  ),
                                ),
                                Row(
                                  children: [
                                    Icon(
                                      Icons.lock_outline,
                                      size: 14,
                                      color: Color(0xFFA1A1AA),
                                    ),
                                    Gap(4.w),
                                    CustomText(
                                      text: itemDetails.subTitle,
                                      fontSize: 12,
                                      fontWeight: FontWeight.w500,
                                      color: Color(0xFFA1A1AA),
                                    ),
                                  ],
                                ),
                              ],
                            ),
                          );
                        },
                      ),
                    ],
                  );
                }
              }),
            ],
          ),
        ),
      ),
    );
  }

  Column _buildGainedBadgeText({required String title}) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Gap(24.h),
        CustomText(
          text: title,
          fontSize: 14,
          fontWeight: FontWeight.w500,
        ),
        Gap(12.h),
      ],
    );
  }
}

